# canvas-api 配置示例。复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，绝不提交。

# ── 服务 ──
CANVAS_API_HOST=0.0.0.0
CANVAS_API_PORT=8081

# ── 数据库（与 sub2api 共享同一个 PG 实例 / database）──
# 本地开发：Docker 映射端口 5434；生产按实际填写。
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_USER=sub2api
DATABASE_PASSWORD=sub2api_dev_password
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

# ── JWT（必须与 sub2api 完全一致，否则无法验证其签发的 token）──
JWT_SECRET=dev_jwt_secret_change_in_production

# ── Wasabi / S3 兼容对象存储（Phase 3 才会用到，先占位）──
# secret 只放这里，绝不写进代码或提交到 git。
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
WASABI_REGION=ap-southeast-1
WASABI_BUCKET=
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=

# ── CORS（允许 infinite-canvas 前端源；逗号分隔）──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
